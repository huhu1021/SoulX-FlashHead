# FlashHead 服务生产环境配置（复制为 .env 后按需修改）

# GPU 设备号（物理卡号，容器内自动映射为 cuda:0；多卡机器按空闲卡指定）
CUDA_DEVICE=3

# 模型档位：lite（单卡4090/5090/A100实时3路） / pro（单卡仅离线出片，实时需双卡）
MODEL_TYPE=lite

# 对外服务端口（宿主机）
FLASHHEAD_PORT=8000

# 接口鉴权密钥（生产环境强烈建议设置；为空则不鉴权）
API_KEY=

# 上传形象是否自动人脸检测裁剪（1=开启）
USE_FACE_CROP=0

# 会话空闲回收时间（秒）与生成视频保留时间（秒）
SESSION_TTL_S=1800
MEDIA_TTL_S=3600
